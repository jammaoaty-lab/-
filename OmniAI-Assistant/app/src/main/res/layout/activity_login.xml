<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_xl">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxxl"
            android:fontFamily="sans-serif-medium"
            android:text="@string/welcome_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_headline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="登录以继续"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_body"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title" />

        <LinearLayout
            android:id="@+id/ll_phone_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxl"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitle">

            <EditText
                android:id="@+id/et_phone"
                style="@style/OmniAI.EditText"
                android:layout_width="0dp"
                android:layout_height="@dimen/input_height"
                android:layout_weight="1"
                android:hint="@string/hint_phone_or_email"
                android:inputType="textEmailAddress"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tv_send_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:paddingVertical="@dimen/spacing_xs"
                android:text="@string/btn_send_code"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_size_body" />

        </LinearLayout>

        <EditText
            android:id="@+id/et_password"
            style="@style/OmniAI.EditText"
            android:layout_width="0dp"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/hint_password"
            android:inputType="textPassword"
            android:singleLine="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_phone_input" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_login"
            style="@style/OmniAI.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="@string/btn_login"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_password" />

        <LinearLayout
            android:id="@+id/ll_divider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_login">

            <View
                android:layout_width="0dp"
                android:layout_height="@dimen/divider_height"
                android:layout_weight="1"
                android:background="@color/divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:text="或"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_size_caption" />

            <View
                android:layout_width="0dp"
                android:layout_height="@dimen/divider_height"
                android:layout_weight="1"
                android:background="@color/divider" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_social_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_divider">

            <ImageView
                android:id="@+id/iv_google"
                android:layout_width="@dimen/icon_xxl"
                android:layout_height="@dimen/icon_xxl"
                android:background="@drawable/bg_card"
                android:contentDescription="Google"
                android:padding="@dimen/spacing_sm"
                android:src="@android:drawable/ic_menu_myplaces"
                android:tint="@color/text_secondary" />

            <ImageView
                android:id="@+id/iv_wechat"
                android:layout_width="@dimen/icon_xxl"
                android:layout_height="@dimen/icon_xxl"
                android:layout_marginStart="@dimen/spacing_lg"
                android:background="@drawable/bg_card"
                android:contentDescription="WeChat"
                android:padding="@dimen/spacing_sm"
                android:src="@android:drawable/ic_menu_share"
                android:tint="@color/text_secondary" />

            <ImageView
                android:id="@+id/iv_qq"
                android:layout_width="@dimen/icon_xxl"
                android:layout_height="@dimen/icon_xxl"
                android:layout_marginStart="@dimen/spacing_lg"
                android:background="@drawable/bg_card"
                android:contentDescription="QQ"
                android:padding="@dimen/spacing_sm"
                android:src="@android:drawable/ic_menu_allfriends"
                android:tint="@color/text_secondary" />

            <ImageView
                android:id="@+id/iv_apple"
                android:layout_width="@dimen/icon_xxl"
                android:layout_height="@dimen/icon_xxl"
                android:layout_marginStart="@dimen/spacing_lg"
                android:background="@drawable/bg_card"
                android:contentDescription="Apple"
                android:padding="@dimen/spacing_sm"
                android:src="@android:drawable/ic_menu_crop"
                android:tint="@color/text_secondary" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_create_account"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxl"
            android:layout_marginBottom="@dimen/spacing_xxl"
            android:text="没有账号？创建你的AI空间"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_size_body"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_social_login" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
